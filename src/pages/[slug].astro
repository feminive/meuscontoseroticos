---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("posts");
const related = allPosts
  .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const wordCount = (post.body || "").split(/\s+/).length;
const readMin = Math.max(1, Math.ceil(wordCount / 220));

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(`/${post.id}/`, siteUrl).href;
const shareUrl = encodeURIComponent(canonicalUrl);
const shareText = encodeURIComponent(post.data.title);
const primaryTag = post.data.tags[0];
const faqItems = post.data.faq ?? [];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    inLanguage: "pt-BR",
    keywords: post.data.tags.join(", "),
    articleSection: primaryTag,
    author: {
      "@type": "Organization",
      name: "Meus Contos Eroticos",
      url: new URL("/", siteUrl).href,
    },
    publisher: {
      "@type": "Organization",
      name: "Meus Contos Eroticos",
      url: new URL("/", siteUrl).href,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: new URL("/", siteUrl).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: post.data.title,
        item: canonicalUrl,
      },
    ],
  },
  ...(faqItems.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqItems.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalURL={canonicalUrl}
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  keywords={[
    post.data.title,
    ...post.data.tags,
    "como escrever contos",
    "escrita criativa",
    "tecnicas narrativas",
  ]}
  structuredData={structuredData}
>

  <article class="reader">

    <header class="reader-head">
      <div class="meta-bar">
        <span class="kicker">{post.data.tags[0]}</span>
        <span class="dot-sep">·</span>
        <time datetime={post.data.publishedAt.toISOString()}>
          {post.data.publishedAt.toLocaleDateString("pt-BR",{day:"numeric",month:"long",year:"numeric"})}
        </time>
        <span class="dot-sep">·</span>
        <span class="read-time">{readMin} min de leitura</span>
      </div>
      <h1 class="reader-title">{post.data.title}</h1>
      <p class="reader-dek">{post.data.description}</p>
    </header>

    <div class="reader-body prose">
      <Content />
    </div>

    <footer class="reader-foot">
      <div class="end-rule">· · ·</div>

      <div class="tags-row">
        {post.data.tags.map(t => <span class="ftag">{t}</span>)}
      </div>

      <div class="share">
        <span class="share-label">Compartilhar este guia</span>
        <div class="share-row">
          <a class="sb" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="sb" href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener">Reddit</a>
          <a class="sb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
          <a class="sb" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener">X</a>
        </div>
      </div>

      <a class="back" href="/">← voltar para a oficina</a>
    </footer>

    {related.length > 0 && (
      <section class="related">
        <h3 class="related-h">Continue lendo</h3>
        <ul>
          {related.map(r => (
            <li>
              <a class="rel-row" href={`/${r.id}`}>
                <h4>{r.data.title}</h4>
                <p>{r.data.description}</p>
                <span class="rel-cta">ler →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </article>

</BaseLayout>

<style>
  .reader {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px 32px 0;
  }
  @media(max-width:600px){.reader{padding:16px 20px 0}}

  /* ── Cabeçalho do conto ── */
  .reader-head {
    padding: 40px 0 56px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }

  .meta-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    font: 500 12px/1 var(--font-sans);
    color: var(--ink-50);
  }
  .kicker {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--primary-strong);
  }
  .dot-sep { color: var(--ink-30); }
  .read-time { font-family: var(--font-mono); letter-spacing: 0; }

  .reader-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(38px, 5.5vw, 60px);
    line-height: 1.04;
    letter-spacing: 0;
    color: var(--deep);
    margin: 0 0 24px;
  }

  .reader-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-70);
    margin: 0;
  }

  /* ── Corpo da leitura ── */
  .reader-body { padding-bottom: 24px; }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--deep);
  }
  .prose :global(h1) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(34px, 4.8vw, 48px);
    line-height: 1.08;
    letter-spacing: 0;
    margin: 2.1em 0 .7em;
  }
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3.8vw, 38px);
    line-height: 1.12;
    letter-spacing: 0;
    margin: 2em 0 .65em;
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.18;
    letter-spacing: 0;
    margin: 1.75em 0 .6em;
  }
  .prose :global(h4) {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: 0;
    margin: 1.5em 0 .55em;
  }
  .prose :global(h1:first-child),
  .prose :global(h2:first-child),
  .prose :global(h3:first-child),
  .prose :global(h4:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.72;
    color: var(--ink-90);
    margin: 0 0 1.4em;
  }
  .reader-body.prose :global(> p:first-of-type::first-letter) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 4.2em;
    line-height: 0.82;
    float: left;
    padding: 8px 14px 0 0;
    color: var(--primary-strong);
  }
  .prose :global(em) { color: var(--primary-strong); font-style: italic; }
  .prose :global(strong) { color: var(--deep); font-weight: 600; }
  .prose :global(a) {
    color: var(--primary-strong);
    text-decoration: underline;
    text-decoration-color: var(--primary);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) {
    color: var(--deep);
    text-decoration-color: var(--deep);
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--primary-strong);
    padding: 0 0 0 24px;
    margin: 1.6em 0;
    font-style: italic;
    color: var(--ink-70);
  }
  .prose :global(blockquote p::first-letter) {
    float: none;
    padding: 0;
    font: inherit;
    color: inherit;
  }
  .prose :global(.md-callout) {
    position: relative;
    margin: 2em 0;
    padding: 26px 28px 28px;
    background:
      linear-gradient(90deg, oklch(0.70 0.06 14 / .10), transparent 54%),
      var(--soft);
    border: 1px solid var(--line);
    border-left: 3px solid var(--primary-strong);
    border-radius: 4px;
    box-shadow: 0 1px 0 oklch(0.70 0.06 14 / .12);
  }
  [data-theme="dark"] .prose :global(.md-callout) {
    background:
      linear-gradient(90deg, oklch(0.74 0.09 14 / .12), transparent 54%),
      var(--card);
    border-color: var(--line);
  }
  .prose :global(.md-callout-label) {
    display: inline-flex;
    margin-bottom: 14px;
    font: 700 11px/1 var(--font-sans);
    color: var(--primary-strong);
    text-transform: uppercase;
  }
  .prose :global(.md-callout-body) {
    white-space: pre-wrap;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink-90);
  }
  .prose :global(.md-callout-body strong) {
    color: var(--deep);
  }
  .prose :global(pre[data-language="md"]) {
    position: relative;
    margin: 2em 0;
    padding: 26px 28px 28px;
    background:
      linear-gradient(90deg, oklch(0.70 0.06 14 / .10), transparent 54%),
      var(--soft) !important;
    color: var(--ink-90) !important;
    border: 1px solid var(--line);
    border-left: 3px solid var(--primary-strong);
    border-radius: 4px;
    box-shadow: 0 1px 0 oklch(0.70 0.06 14 / .12);
    overflow-x: visible !important;
    white-space: pre-wrap;
  }
  [data-theme="dark"] .prose :global(pre[data-language="md"]) {
    background:
      linear-gradient(90deg, oklch(0.74 0.09 14 / .12), transparent 54%),
      var(--card) !important;
    border-color: var(--line);
  }
  .prose :global(pre[data-language="md"] code) {
    display: block;
    white-space: pre-wrap;
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink-90) !important;
  }
  .prose :global(pre[data-language="md"] span) {
    color: var(--ink-90) !important;
    background: transparent !important;
  }
  .prose :global(hr) {
    border: 0;
    text-align: center;
    margin: 2em 0;
  }
  .prose :global(hr::before) {
    content: "· · ·";
    color: var(--primary-strong);
    letter-spacing: 0;
    font-size: 18px;
  }

  /* ── Rodapé ── */
  .reader-foot { padding: 8px 0 56px; }

  .end-rule {
    text-align: center;
    color: var(--primary-strong);
    letter-spacing: 0;
    font-size: 18px;
    margin: 16px 0 40px;
  }

  .tags-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .ftag {
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 0;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--primary-strong);
    background: oklch(0.96 0.022 14);
    border: 1px solid oklch(0.88 0.04 14);
  }
  [data-theme="dark"] .ftag {
    background: oklch(0.20 0.04 14);
    border-color: oklch(0.30 0.05 14);
    color: var(--primary);
  }

  .share {
    background: var(--soft);
    border-radius: 4px;
    padding: 24px;
    margin-bottom: 40px;
  }
  [data-theme="dark"] .share { background: var(--card); border: 1px solid var(--line); }

  .share-label {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink-50);
    display: block;
    margin-bottom: 14px;
  }
  .share-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .sb {
    font: 600 12px/1 var(--font-sans);
    padding: 10px 16px;
    background: var(--page);
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--ink-70);
    text-decoration: none;
    transition: all .2s;
    letter-spacing: 0;
  }
  [data-theme="dark"] .sb { background: var(--page); }
  .sb:hover { background: var(--deep); color: var(--page); border-color: var(--deep); }

  .back {
    font: 500 13px/1 var(--font-sans);
    color: var(--primary-strong);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* ── Continue lendo ── */
  .related {
    border-top: 1px solid var(--line);
    padding: 56px 0 24px;
  }
  .related-h {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: 0;
    color: var(--deep);
    margin: 0 0 32px;
    font-style: italic;
  }
  .related ul { list-style: none; padding: 0; margin: 0; }
  .related li { border-top: 1px solid var(--line); }
  .related li:last-child { border-bottom: 1px solid var(--line); }

  .rel-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 22px 0;
    text-decoration: none;
    transition: padding .2s;
  }
  .rel-row:hover { padding-left: 8px; padding-right: 8px; }

  .rel-row h4 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.25;
    color: var(--deep);
    margin: 0 0 4px;
    transition: color .2s;
    grid-column: 1;
  }
  .rel-row:hover h4 { color: var(--primary-strong); }
  .rel-row p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-50);
    margin: 0;
    grid-column: 1;
  }
  .rel-cta {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font: 600 11px/1 var(--font-sans);
    color: var(--primary-strong);
    letter-spacing: 0;
    white-space: nowrap;
  }
</style>
