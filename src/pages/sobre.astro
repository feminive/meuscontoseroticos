---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR_NAME, SITE_NAME, organizationSchema } from "../lib/site";

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
---

<BaseLayout
  title="Sobre"
  description="Conheça a proposta editorial da Oficina de Contos Eróticos, sua autoria, escopo e critérios de publicação."
  canonicalURL={new URL("/sobre/", siteUrl).href}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: `Sobre — ${SITE_NAME}`,
    url: new URL("/sobre/", siteUrl).href,
    inLanguage: "pt-BR",
    publisher: organizationSchema(siteUrl),
  }}
>
  <main class="info-page">
    <span class="kicker">institucional</span>
    <h1>Sobre a oficina</h1>

    <div class="info-body">
      <p>
        A Oficina de Contos Eróticos é um arquivo editorial sobre escrita erótica, narrativa curta, publicação independente e construção de público em nichos adultos.
      </p>
      <p>
        O conteúdo é assinado por {AUTHOR_NAME} e trata erotismo como linguagem literária, com foco em técnica, contexto, responsabilidade adulta e qualidade textual.
      </p>
      <p>
        O site publica guias, ensaios e exercícios para pessoas adultas interessadas em escrever melhor, organizar ideias e entender os limites editoriais do tema.
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .info-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 72px 32px 0;
  }
  @media(max-width:640px){.info-page{padding:48px 20px 0}}
  .kicker {
    display: block;
    margin-bottom: 16px;
    font: 700 11px/1 var(--font-sans);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--primary-strong);
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1;
    letter-spacing: 0;
    color: var(--deep);
    margin: 0 0 40px;
  }
  .info-body {
    border-top: 1px solid var(--line);
    padding-top: 40px;
  }
  p {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.72;
    color: var(--ink-90);
    margin: 0 0 1.25em;
  }
</style>
